---
import BaseLayout from '../layouts/BaseLayout.astro';
import conferences from '../../assets/data/conferences.json';
import videoGroups from '../../assets/data/videos2.json';
import articleGroups from '../../assets/data/articles.json';

const formatDate = (date) => {
  if (!date) return 'Date TBA';
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${date}T00:00:00Z`));
};

const formatCompactDate = (date) => {
  if (!date) return { day: 'TBA', year: '' };
  const value = new Date(`${date}T00:00:00Z`);
  return {
    day: new Intl.DateTimeFormat('en', {
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(value).toUpperCase(),
    year: String(value.getUTCFullYear()),
  };
};

const parseVideoDate = (date) => {
  if (!date) return 0;
  const parsed = Date.parse(date);
  return Number.isNaN(parsed) ? 0 : parsed;
};

const rolesFor = (event) =>
  event.roles || [...new Set((event.talks || []).map((talk) => talk.role).filter(Boolean))];

const roleLabel = (role) =>
  ({ speaker: 'Speaker', mentor: 'Mentor', organizer: 'Organizer', host: 'Host', jury: 'Jury', panellist: 'Panellist' })[role] || role;

const videos = videoGroups
  .filter((group) => group.display !== false)
  .flatMap((group) =>
    (group.videos || []).map((video) => ({
      ...video,
      groupTitle: group.title,
      eventName: video.event?.name || video.event || group.event?.name || group.event || group.title,
      timestamp: parseVideoDate(video.date),
    })),
  )
  .sort((a, b) => b.timestamp - a.timestamp);

const individualArticles = articleGroups
  .flatMap((group) =>
    (group.articles || []).map((article) => ({
      ...article,
      groupId: group.id,
      groupTitle: group.kind === 'series' ? group.title : undefined,
      groupKind: group.kind,
      href: article.links?.[0]?.url || '/articles',
    })),
  )
  .filter((article) => article.date)
  .sort((a, b) => b.date.localeCompare(a.date));

const latestArticle = individualArticles[0];

const articleEntries = articleGroups
  .flatMap((group) => {
    if (group.kind === 'series') {
      const latest = [...(group.articles || [])].sort((a, b) =>
        (b.date || '').localeCompare(a.date || ''),
      )[0];
      if (!latest) return [];
      return [{
        id: group.id,
        title: group.title,
        description: group.description || group.subtitle || '',
        image: latest.image,
        date: latest.date,
        type: `${group.articles.length}-part series`,
        detail: group.subtitle || 'Article series',
        href: '/articles',
        external: false,
      }];
    }

    return (group.articles || [])
      .filter((article) => article.links?.[0])
      .map((article) => ({
        id: article.id,
        title: article.title,
        description: article.description,
        image: article.image,
        date: article.date,
        type: 'Article',
        detail: article.links.map((link) => link.label).join(' · '),
        href: article.links[0].url,
        external: true,
      }));
  })
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 3);

const today = new Date().toISOString().slice(0, 10);
const upcomingTalks = conferences
  .filter((event) => event.date && event.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
const recentTalks = conferences
  .filter((event) => !event.date || event.date < today)
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const highlightedTalks = (upcomingTalks.length > 0 ? upcomingTalks : recentTalks).slice(0, 2);
const highlightedTalksLabel = upcomingTalks.length > 0 ? 'Next talks' : 'Recent talks';
const featuredTalks = [...upcomingTalks, ...recentTalks].slice(0, 5);
const featuredVideos = videos.slice(0, 3);
const latestVideo = featuredVideos[0];
const isUpcoming = (date) => Boolean(date && date >= today);
---

<BaseLayout
  path="/"
  title="Olivier Leplus — Developer Advocate, Speaker & Writer"
  description="Recent articles, conference talks, and videos by Olivier Leplus, Senior Developer Advocate at AWS and Google Developer Expert in Web technologies."
>
  <main class="home">
    <header class="intro">
      <div class="intro__copy">
        <span class="eyebrow">Senior Developer Advocate @ AWS · Google Developer Expert in Web Technologies</span>
        <h1>I build, write, and speak about the Web and AI.</h1>
        <p>
          Technical writer and conference speaker sharing what I learn by building with emerging technology.
        </p>
        <div class="intro__links">
          <a class="button" href="#latest">See what’s new <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/bio">Biography &amp; speaker kit <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="intro__portrait" aria-hidden="true">
        <div class="intro__halo"></div>
        <img src="/assets/avatar.jpeg" alt="" />
        <span class="intro__status"><i></i> Paris, France</span>
      </div>
    </header>

    <section class="section latest" id="latest" aria-labelledby="latest-heading">
      <div class="section-heading section-heading--wide">
        <div>
          <span class="eyebrow">Latest activity</span>
          <h2 id="latest-heading">What’s new.</h2>
        </div>
        <p>The newest thing I published, where I’m speaking next, and my latest video.</p>
      </div>

      <div class="latest-grid">
        {latestArticle && (
          <a
            class="latest-article"
            href={latestArticle.href}
            target="_blank"
            rel="noopener"
            aria-label={`Read ${latestArticle.title}`}
          >
            <img src={latestArticle.image} alt="" />
            <span class="latest-article__shade"></span>
            <div class="latest-article__content">
              <div class="meta-line">
                <span>Latest article</span>
                {latestArticle.groupTitle && <span>{latestArticle.groupTitle}</span>}
                <time datetime={latestArticle.date}>{formatDate(latestArticle.date)}</time>
              </div>
              <h3>{latestArticle.title}</h3>
              <p>{latestArticle.description}</p>
              <span class="card-action">Read the article <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        )}

        <div class="latest-side">
          {highlightedTalks.length > 0 && (
            <div class="activity-card activity-card--talk">
              <div class="activity-card__top">
                <span class="meta-label">{highlightedTalksLabel}</span>
                <a href="/conferences">All talks <span aria-hidden="true">→</span></a>
              </div>
              <div class="activity-card__talks">
                {highlightedTalks.map((talk) => (
                  <a
                    class="talk-brief"
                    href={talk.link || '/conferences'}
                    target={talk.link ? '_blank' : undefined}
                    rel={talk.link ? 'noopener' : undefined}
                  >
                    <time datetime={talk.date}>
                      <span>{formatCompactDate(talk.date).day}</span>
                      <small>{formatCompactDate(talk.date).year}</small>
                    </time>
                    <div class="talk-brief__content">
                      <h3>{(talk.talks || [])[0]?.title || talk.name}</h3>
                      <span>{talk.name}</span>
                    </div>
                    <span class="talk-brief__arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          {latestVideo && (
            <a
              class="activity-card activity-card--video"
              href={`https://www.youtube.com/watch?v=${latestVideo.youtubeId}`}
              target="_blank"
              rel="noopener"
            >
              <img
                src={`https://img.youtube.com/vi/${latestVideo.youtubeId}/mqdefault.jpg`}
                alt=""
              />
              <span class="activity-card__video-shade"></span>
              <div class="activity-card__video-copy">
                <span class="meta-label">Latest video</span>
                <h3>{latestVideo.title}</h3>
                <span>{latestVideo.eventName} · {latestVideo.date}</span>
              </div>
              <span class="play" aria-hidden="true">▶</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="articles-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Writing</span>
          <h2 id="articles-heading">Latest articles.</h2>
        </div>
        <a class="section-link" href="/articles">All articles <span aria-hidden="true">→</span></a>
      </div>

      <div class="article-grid">
        {articleEntries.map((article, index) => (
          <a
            class:list={['article-card', { 'article-card--lead': index === 0 }]}
            href={article.href}
            target={article.external ? '_blank' : undefined}
            rel={article.external ? 'noopener' : undefined}
          >
            <div class="article-card__media">
              <img src={article.image} alt="" loading="lazy" />
              <span class="article-card__index">0{index + 1}</span>
            </div>
            <div class="article-card__body">
              <div class="meta-line">
                <span>{article.type}</span>
                <time datetime={article.date}>{formatDate(article.date)}</time>
              </div>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
              <div class="article-card__footer">
                <span>{article.detail}</span>
                <span aria-hidden="true">{article.external ? '↗' : '→'}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="talks-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Speaking</span>
          <h2 id="talks-heading">Recent &amp; upcoming talks.</h2>
        </div>
        <a class="section-link" href="/conferences">All talks <span aria-hidden="true">→</span></a>
      </div>

      <div class="talk-list">
        {featuredTalks.map((event) => (
          <article class="talk-row">
            <div class="talk-row__date">
              <time datetime={event.date}>{formatDate(event.date)}</time>
              {isUpcoming(event.date) && <span class="upcoming">Upcoming</span>}
            </div>
            <div class="talk-row__content">
              <h3>
                {event.link ? (
                  <a href={event.link} target="_blank" rel="noopener">{event.name}</a>
                ) : (
                  event.name
                )}
              </h3>
              {(event.talks || [])[0] && <p>{event.talks[0].title}</p>}
              <div class="role-list">
                {rolesFor(event).map((role) => (
                  <span class={`role role--${role}`}>{roleLabel(role)}</span>
                ))}
              </div>
            </div>
            <div class="talk-row__location">
              <span>{event.location?.city || event.location?.name || 'Location TBA'}</span>
              <small>{event.location?.country || ''}</small>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="videos-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Watch</span>
          <h2 id="videos-heading">Latest videos.</h2>
        </div>
        <a class="section-link" href="/videos">All videos <span aria-hidden="true">→</span></a>
      </div>

      <div class="video-grid">
        {featuredVideos.map((video) => (
          <a
            class="video-card"
            href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
            target="_blank"
            rel="noopener"
          >
            <div class="video-card__media">
              <img
                src={`https://img.youtube.com/vi/${video.youtubeId}/mqdefault.jpg`}
                alt=""
                loading="lazy"
              />
              <span class="video-card__duration">{video.duration || ''}</span>
              <span class="video-card__play" aria-hidden="true">▶</span>
            </div>
            <div class="video-card__body">
              <h3>{video.title}</h3>
              <div>
                <span>{video.eventName}</span>
                <time>{video.date}</time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <footer class="footer">
      <div>
        <span class="eyebrow">Keep in touch</span>
        <p>More experiments, articles, and conference notes as I publish them.</p>
      </div>
      <div class="footer__links">
        <a href="/bio">Biography</a>
        <a href="https://www.linkedin.com/in/olivierleplus/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://github.com/tagazok" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .home {
    position: relative;
    z-index: 1;
    width: min(1120px, calc(100% - 48px));
    min-width: 0;
    margin: 0 auto;
    padding: 50px 0 64px;
  }

  .eyebrow,
  .meta-label {
    color: var(--accent-3);
    font: 500 10px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    align-items: center;
    min-height: 370px;
    gap: clamp(36px, 7vw, 82px);
    padding: 30px 0 48px;
    border-bottom: 1px solid var(--glass-border);
  }

  .intro__copy {
    max-width: 740px;
  }

  .intro h1 {
    max-width: 740px;
    margin: 15px 0 20px;
    color: var(--text);
    font-size: clamp(40px, 5.3vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .intro__copy > p {
    max-width: 690px;
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .intro__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 12px;
    padding: 0 18px;
    border: 1px solid rgba(99, 102, 241, 0.55);
    border-radius: 999px;
    color: var(--text);
    background: var(--accent-soft);
    font-size: 11px;
    font-weight: 600;
  }

  .button:hover {
    border-color: var(--accent);
    color: var(--text);
    background: rgba(99, 102, 241, 0.24);
    transform: translateY(-2px);
  }

  .text-link {
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 500;
  }

  .text-link:hover {
    color: var(--text);
  }

  .intro__portrait {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .intro__portrait img {
    position: relative;
    z-index: 1;
    width: 165px;
    height: 165px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.32);
  }

  .intro__halo {
    position: absolute;
    top: 8px;
    width: 165px;
    height: 165px;
    border-radius: 50%;
    background: conic-gradient(var(--accent), var(--accent-2), var(--accent-3), var(--accent));
    opacity: 0.38;
    filter: blur(24px);
  }

  .intro__status {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: -12px;
    padding: 8px 11px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--text-muted);
    background: rgba(15, 15, 19, 0.9);
    font: 500 9px var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .intro__status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-3);
    box-shadow: 0 0 12px var(--accent-3);
  }

  .section {
    padding: 74px 0;
    border-bottom: 1px solid var(--glass-border);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 27px;
  }

  .section-heading--wide > p {
    max-width: 390px;
    margin: 0 0 3px;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .section h2 {
    margin: 9px 0 0;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .section-link {
    flex: 0 0 auto;
    color: var(--text-muted);
    font: 500 10px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-link:hover {
    color: var(--accent-3);
  }

  .latest-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: 18px;
  }

  .latest-article,
  .activity-card,
  .article-card,
  .video-card {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    color: var(--text);
    background: var(--glass);
    text-decoration: none;
    backdrop-filter: blur(10px);
    transition: border-color 0.24s, transform 0.24s, background 0.24s;
  }

  .latest-article:hover,
  .activity-card:hover,
  .article-card:hover,
  .video-card:hover {
    border-color: rgba(99, 102, 241, 0.7);
    color: var(--text);
    transform: translateY(-4px);
  }

  .latest-article {
    position: relative;
    min-height: 480px;
    overflow: hidden;
  }

  .latest-article > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .latest-article:hover > img {
    transform: scale(1.035);
  }

  .latest-article__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 8, 12, 0.05) 20%, rgba(8, 8, 12, 0.96) 92%),
      linear-gradient(90deg, rgba(8, 8, 12, 0.45), transparent 58%);
  }

  .latest-article__content {
    position: absolute;
    z-index: 1;
    right: 29px;
    bottom: 28px;
    left: 29px;
  }

  .meta-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--accent-3);
    font: 500 9px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .meta-line > * + *::before {
    margin-right: 8px;
    color: rgba(241, 245, 249, 0.32);
    content: '·';
  }

  .meta-line time {
    color: rgba(241, 245, 249, 0.62);
  }

  .latest-article h3 {
    max-width: 760px;
    margin: 12px 0 10px;
    font-size: clamp(27px, 3.7vw, 43px);
    line-height: 1.07;
    letter-spacing: -0.045em;
  }

  .latest-article p {
    display: -webkit-box;
    max-width: 690px;
    margin: 0;
    overflow: hidden;
    color: rgba(241, 245, 249, 0.66);
    font-size: 12px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-action {
    display: inline-block;
    margin-top: 17px;
    color: var(--text);
    font: 500 9px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .latest-side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 18px;
  }

  .activity-card {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  .activity-card--talk {
    display: flex;
    flex-direction: column;
    padding: 18px 21px;
    background:
      linear-gradient(140deg, rgba(99, 102, 241, 0.16), transparent 55%),
      var(--glass);
  }

  .activity-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding-bottom: 8px;
  }

  .activity-card__top > a {
    color: var(--text-dim);
    font: 500 8px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .activity-card__top > a:hover {
    color: var(--accent-3);
  }

  .activity-card__talks {
    display: grid;
    min-height: 0;
    flex: 1;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .talk-brief {
    display: grid;
    min-width: 0;
    grid-template-columns: 50px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--glass-border);
    color: var(--text);
  }

  .talk-brief:hover {
    color: var(--text);
  }

  .talk-brief time {
    display: grid;
    gap: 2px;
    color: var(--accent-3);
    font: 500 8px/1.35 var(--font-mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .talk-brief time small {
    color: var(--text-dim);
    font: inherit;
    font-size: 7px;
    letter-spacing: 0.08em;
  }

  .talk-brief__content {
    min-width: 0;
  }

  .talk-brief h3 {
    display: -webkit-box;
    margin: 0 0 4px;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: -0.02em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .talk-brief__content > span {
    display: block;
    overflow: hidden;
    color: var(--text-dim);
    font: 500 8px var(--font-mono);
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .talk-brief__arrow {
    color: var(--text-dim);
    font-size: 10px;
    transition: color 0.2s, transform 0.2s;
  }

  .talk-brief:hover .talk-brief__arrow {
    color: var(--accent-3);
    transform: translate(2px, -2px);
  }

  .activity-card--video > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .activity-card--video:hover > img {
    transform: scale(1.045);
  }

  .activity-card__video-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 8, 12, 0.08) 16%, rgba(8, 8, 12, 0.94) 100%);
  }

  .activity-card__video-copy {
    position: absolute;
    z-index: 1;
    right: 20px;
    bottom: 18px;
    left: 20px;
  }

  .activity-card__video-copy h3 {
    display: -webkit-box;
    margin: 7px 0;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .activity-card__video-copy > span:last-child {
    color: rgba(241, 245, 249, 0.52);
    font: 500 8px var(--font-mono);
    text-transform: uppercase;
  }

  .play {
    position: absolute;
    z-index: 2;
    top: 18px;

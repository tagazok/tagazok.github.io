---
import BaseLayout from '../layouts/BaseLayout.astro';
import videoData from '../../assets/data/videos2.json';

const categories = videoData.filter((c) => c.display !== false);

const parseDate = (str) => {
  if (!str) return 0;
  const m = str.match(/(\w+)\s+(\d+),\s+(\d{4})/);
  return m ? new Date(`${m[1]} ${m[2]}, ${m[3]}`).getTime() : 0;
};

// Flatten ALL videos (tab filtering happens client-side); tag each with its category.
const allVideos = categories
  .flatMap((c) =>
    (c.videos || []).map((v) => ({ ...v, category: c.title, _event: v.event || c.event })),
  )
  .sort((a, b) => parseDate(b.date) - parseDate(a.date));

const totalCount = categories.reduce((s, c) => s + c.videos.length, 0);

const tabs = [{ id: 'all', label: 'All' }].concat(
  categories.map((c) => ({ id: c.title, label: c.title })),
);
---

<BaseLayout
  path="/videos"
  title="Videos — Olivier Leplus"
  description="Watch conference sessions, technical presentations, and developer videos by Olivier Leplus."
>
  <main class="videos-page">
    <header class="videos-hero">
      <div>
        <span class="eyebrow">Watch archive</span>
        <h1 class="videos-hero__title">Videos.</h1>
        <p class="videos-hero__intro">
          Conference recordings, technical demonstrations, interviews, and conversations about the Web, cloud, and AI.
        </p>
      </div>
      <p class="videos-hero__count">
        <strong>{totalCount}</strong> videos<br />across {categories.length} series
      </p>
    </header>

    <div class="videos-tabs" aria-label="Filter videos by series" data-tabs>
      {
        tabs.map((t) => (
          <button
            class:list={['tab', { 'tab--active': t.id === 'all' }]}
            data-tab={t.id}
            aria-pressed={t.id === 'all'}
          >
            {t.label}
          </button>
        ))
      }
    </div>

    <section class="videos-grid">
      {
        allVideos.map((v) => (
          <a
            href={`https://www.youtube.com/watch?v=${v.youtubeId}`}
            class="vcard"
            data-category={v.category}
            target="_blank"
            rel="noopener"
          >
            <div class="vcard__thumb">
              <img
                src={`https://img.youtube.com/vi/${v.youtubeId}/mqdefault.jpg`}
                alt={v.title}
                loading="lazy"
              />
              <span class="vcard__duration">{v.duration || ''}</span>
            </div>
            <div class="vcard__body">
              <h3 class="vcard__title">{v.title}</h3>
              <div class="vcard__meta">
                <span class="vcard__event">
                  {(v._event && (v._event.name || v._event)) || v.category}
                </span>
                <span class="vcard__date">{v.date || ''}</span>
              </div>
            </div>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tabs] .tab'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.vcard[data-category]'));

  const setTab = (id: string) => {
    tabButtons.forEach((btn) => {
      const active = btn.dataset.tab === id;
      btn.classList.toggle('tab--active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
    cards.forEach((card) => {
      card.hidden = id !== 'all' && card.dataset.category !== id;
      card.classList.remove('vcard--featured');
    });
    cards.find((card) => !card.hidden)?.classList.add('vcard--featured');
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => setTab(btn.dataset.tab || 'all'));
  });

  setTab('all');
</script>

<style>
  @layer legacy {
  .videos-page {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 24px 80px;
  }
  .videos-hero {
    text-align: center;
    margin-bottom: 40px;
  }
  .videos-hero__title {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1px;
  }
  .videos-hero__count {
    margin-top: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .videos-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
    justify-content: center;
  }
  .tab {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--glass-border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
  }
  .tab:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .tab--active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .vcard {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    backdrop-filter: blur(8px);
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }
  .vcard:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    color: var(--text);
  }
  .vcard__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .vcard__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .vcard:hover .vcard__thumb img {
    transform: scale(1.05);
  }
  .vcard__duration {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .vcard__body {
    padding: 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .vcard__title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .vcard__meta {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
  }
  .vcard__event {
    color: var(--accent);
    font-weight: 600;
  }
  .vcard__date {
    color: var(--text-dim);
  }
  @media (max-width: 768px) {
    .videos-page {
      padding: 80px 16px 60px;
    }
    .videos-hero__title {
      font-size: 28px;
    }
    .videos-grid {
      grid-template-columns: 1fr;
    }
    .videos-tabs {
      padding-bottom: 8px;
    }
    .tab {
      white-space: nowrap;
    }
  }
  }
</style>

<style>
  /* Content-first archive redesign */
  .videos-page {
    width: min(1120px, calc(100% - 48px));
    max-width: none;
    padding: 58px 0 96px;
  }

  .videos-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 48px;
    margin: 0 0 34px;
    padding: 30px 0 38px;
    border-bottom: 1px solid var(--glass-border);
    text-align: left;
  }

  .eyebrow {
    color: var(--accent-3);
    font: 500 10px var(--font-mono);
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .videos-hero__title {
    margin: 12px 0 16px;
    font-size: clamp(42px, 7vw, 68px);
    line-height: .95;
    letter-spacing: -.06em;
  }

  .videos-hero__intro {
    max-width: 680px;
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .videos-hero__count {
    margin: 0 0 3px;
    color: var(--text-dim);
    font: 500 10px/1.7 var(--font-mono);
    letter-spacing: .06em;
    text-align: right;
    text-transform: uppercase;
  }

  .videos-hero__count strong {
    color: var(--text);
    font-size: 24px;
    letter-spacing: -.04em;
  }

  .videos-tabs {
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 24px;
    padding-bottom: 6px;
  }

  .videos-tabs::-webkit-scrollbar { display: none; }

  .tab {
    flex: 0 0 auto;
    min-height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    font: 500 9px var(--font-mono);
    letter-spacing: .04em;
    white-space: nowrap;
  }

  .tab--active {
    border-color: rgba(99, 102, 241, .5);
    background: var(--accent-soft);
    color: var(--text);
  }

  .videos-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .vcard {
    min-width: 0;
    background: var(--glass);
    transition: transform .24s, border-color .24s, background .24s;
  }

  .vcard--featured {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(220px, .65fr);
    min-height: 310px;
  }

  .vcard--featured .vcard__thumb { aspect-ratio: auto; }
  .vcard--featured .vcard__body { padding: 24px; }
  .vcard--featured .vcard__title {
    font-size: clamp(20px, 2.2vw, 29px);
    line-height: 1.2;
    letter-spacing: -.04em;
    -webkit-line-clamp: 4;
  }

  .vcard__thumb::after {
    content: '▶';
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, .25);
    border-radius: 50%;
    color: #fff;
    background: rgba(15, 15, 19, .72);
    font-size: 12px;
    transform: translate(-50%, -50%);
    backdrop-filter: blur(8px);
  }

  .vcard__body { padding: 17px; }
  .vcard__title { font-size: 15px; font-weight: 600; letter-spacing: -.025em; }
  .vcard__event { color: var(--accent-3); font: 500 9px var(--font-mono); text-transform: uppercase; }
  .vcard__date { font: 500 9px var(--font-mono); }

  @media (max-width: 900px) {
    .videos-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vcard--featured { grid-column: 1 / -1; }
  }

  @media (max-width: 680px) {
    .videos-page { width: min(100% - 32px, 620px); padding: 26px 0 70px; }
    .videos-hero { grid-template-columns: 1fr; gap: 16px; padding: 30px 0 28px; }
    .videos-hero__count { text-align: left; }
    .videos-tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .videos-grid { grid-template-columns: 1fr; }
    .vcard--featured { display: flex; min-height: 0; }
    .vcard--featured .vcard__thumb { aspect-ratio: 16 / 9; }
    .vcard--featured .vcard__body { padding: 17px; }
    .vcard--featured .vcard__title { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vcard, .vcard img { transition: none; }
  }
</style>
